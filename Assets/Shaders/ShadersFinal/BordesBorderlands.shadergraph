{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6501f22f984443bfb7c723791e0129b9",
    "m_Title": "",
    "m_Content": "Dureza vuelve la l\u00ednea s\u00f3lida (sin mezclarse con lo de abajo). Blend Mode = Alpha. Color = color de la m\u00e1scara (el \"Color Bordes\" del material del objeto); alpha = l\u00ednea \u00d7 alfa de la m\u00e1scara. Materiales sin Color Bordes (o con alfa 0) no llevan l\u00edneas. La silueta se dibuja del lado del objeto m\u00e1s cercano para tomar su color.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 2050.0,
        "y": 200.0,
        "width": 460.0,
        "height": 100.0
    },
    "m_Group": {
        "m_Id": "2eed5b61933d42deb101abb8dcfc35c6"
    }
}

