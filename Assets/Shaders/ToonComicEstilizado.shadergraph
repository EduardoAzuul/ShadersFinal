{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "dc9068f8401342eaa48d3707710d2820",
    "m_Group": {
        "m_Id": "0e9743735bc3425288e8dd021c9d2c21"
    },
    "m_Name": "LuzPrincipal",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3300.0,
            "y": -100.0,
            "width": 234.9999542236328,
            "height": 93.99998474121094
        }
    },
    "m_Slots": [
        {
            "m_Id": "6a709777705e4a4e9047ca65c3f9e290"
        },
        {
            "m_Id": "94c8b2932a514c51b4618702fac74fd4"
        },
        {
            "m_Id": "d1fa7bc1ad61409dbb35f99dd06df995"
        },
        {
            "m_Id": "3b15ecf4db62467b846f3d04913d9157"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "LuzPrincipal",
    "m_FunctionSource": "",
    "m_FunctionBody": "#ifdef SHADERGRAPH_PREVIEW\n    Direccion = normalize(float3(0.5, 0.7, -0.5));\n    ColorLuz = float3(1, 1, 1);\n    Sombra = 1;\n#else\n    #if defined(UNIVERSAL_LIGHTING_INCLUDED)\n        // coordenada en el shadow map de la luz principal\n        float4 coordSombra = TransformWorldToShadowCoord(PosicionWS);\n        Light luz = GetMainLight(coordSombra);\n        Direccion = luz.direction;          // apunta HACIA la luz\n        ColorLuz = luz.color;\n        Sombra = luz.shadowAttenuation;     // 0 = en sombra, 1 = iluminado\n    #else\n        Direccion = normalize(float3(0.5, 0.7, -0.5));\n        ColorLuz = float3(1, 1, 1);\n        Sombra = 1;\n    #endif\n#endif"
}

{
    "m_SGVersion": 0,
