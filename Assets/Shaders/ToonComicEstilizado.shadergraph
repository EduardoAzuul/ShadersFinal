{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d6ddfa89db5d4e29896e00d35161639e",
    "m_Title": "",
    "m_Content": "Triplanar: la trama se proyecta desde los 3 ejes del objeto y se elige seg\u00fan la normal. En un cubo cada cara usa exactamente una proyecci\u00f3n (puntos cuadrados y sin estirar); en curvas se mezclan. Se multiplica por la escala del objeto para que la densidad no cambie al escalarlo. Nitidez alta = transici\u00f3n m\u00e1s corta entre proyecciones.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3550.0,
        "y": 1950.0,
        "width": 460.0,
        "height": 120.0
    },
    "m_Group": {
        "m_Id": "020710fcf4b4497f97999afeacd46fda"
    }
}

{
