    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "b03694415990401ba8abaadddde6a1ad",
    "m_Title": "",
    "m_Content": "Main Light Direction apunta HACIA donde viaja la luz, por eso el Remap invierte: N\u00b7L = -1 (cara iluminada) \u2192 0, N\u00b7L = 1 (cara en sombra) \u2192 1. El resultado es el RADIO del punto: m\u00e1s sombra = punto m\u00e1s grande.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
