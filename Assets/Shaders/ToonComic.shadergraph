{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1166f958b6a54aa1ba42f8d77f207c3c",
    "m_Title": "",
    "m_Content": "Posici\u00f3n en pantalla corregida por el aspecto (para que las celdas sean cuadradas), rotada (\u00e1ngulo cl\u00e1sico de c\u00f3mic = 45\u00b0) y repetida con Fraction. Length da la distancia de cada p\u00edxel al centro de su celda: 0 en el centro, ~0.707 en las esquinas.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
